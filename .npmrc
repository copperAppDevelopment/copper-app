ignore-scripts=true

; Required for EAS Build + pnpm monorepo: makes React Native autolinking find expo-modules-core
shamefully-hoist=true

; shamefully-hoist no alcanza a las devDependencies, así que @types/react queda encerrado en
; .pnpm/ y el .d.ts de un tercero no puede resolverlo: expo-camera declara
; `CameraView extends Component` contra un React sin tipar y su clase deja de valer como
; componente JSX (TS2786). Se arregla aquí y no con `paths` en el tsconfig, porque
; expo/metro-config aplica esos paths como alias de Metro y aliasar `react` rompe el bundle.
public-hoist-pattern[]=@types/react
