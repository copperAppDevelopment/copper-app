{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "react": ["./node_modules/react"],
      "react/*": ["./node_modules/react/*"],
      "@types/react": ["./node_modules/@types/react"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "../../node_modules"
  ]
}