---
import Layout from './Layout.astro';
import Navbar from '../features/navigation/Navbar.tsx';
import Footer from '../features/navigation/Footer.tsx';

interface Props {
  title: string;
  description: string;
  /** Encabezado impreso en la página, sin el sufijo «- Copper App» del <title>. */
  encabezado: string;
  actualizado: string;
}

const { title, description, encabezado, actualizado } = Astro.props;
---

<Layout title={title} description={description}>
  <Navbar client:load />

  <main class="bg-white dark:bg-black transition-colors duration-300">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">

      {/* Los enlaces de la barra son anclas del index, así que desde aquí no llevan a
          ninguna parte: esta es la vuelta al inicio. */}
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-500 hover:text-[#8A1C14] dark:hover:text-red-400 transition-colors"
      >
        <span aria-hidden="true">&larr;</span> Volver al inicio
      </a>

      <header class="mt-6 mb-12 pb-8 border-b border-zinc-200 dark:border-neutral-900">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white text-balance">
          {encabezado}
        </h1>
        <p class="mt-3 text-sm text-zinc-500">
          Última actualización: {actualizado}
        </p>
      </header>

      <article class="legal">
        <slot />
      </article>

    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* El landing no trae @tailwindcss/typography, así que el ritmo de estos documentos
     se define aquí una sola vez en vez de repetir utilidades en cada párrafo. */
  .legal {
    color: var(--color-zinc-600, #52525b);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
  .dark .legal {
    color: #a1a1aa;
  }

  .legal h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    color: #18181b;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .dark .legal h2 {
    color: #ffffff;
  }
  .legal > h2:first-child {
    margin-top: 0;
  }

  .legal p {
    margin-bottom: 1rem;
  }

  .legal ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .legal li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.625rem;
  }
  .legal li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.7em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background-color: #8A1C14;
  }

  .legal a {
    color: #8A1C14;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .dark .legal a {
    color: #f87171;
  }

  .legal strong {
    font-weight: 600;
    color: #27272a;
  }
  .dark .legal strong {
    color: #e4e4e7;
  }

  /* Bloque de datos del responsable y espacio de firma. */
  .legal .recuadro {
    border: 1px solid #e4e4e7;
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    background-color: #fafafa;
  }
  .dark .legal .recuadro {
    border-color: #171717;
    background-color: #0a0a0a;
  }
  .legal .recuadro p:last-child {
    margin-bottom: 0;
  }
</style>
