PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
# Wompi — pasarela de las suscripciones. Las rutas /api/v1/pagos/* las leen en el
# servidor; ninguna es NEXT_PUBLIC_. Para probar en sandbox basta con poner aquí las
# llaves de prueba y la URL del checkout de sandbox: ya no hay que redesplegar nada.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# A dónde vuelve el navegador tras pagar, y de dónde sale la URL del webhook que hay
# que registrar en el panel de Wompi: {APP_BASE_URL}/api/v1/pagos/webhook
APP_BASE_URL=
