---
import Layout from '../layouts/Layout.astro';
import Navbar from '../features/navigation/Navbar.tsx';
import Hero from '../features/hero/Hero.tsx';
import AboutUs from '../features/about/AboutUs.tsx';
import Features from '../features/features-list/Features.tsx';
import Benefits from '../features/benefits/Benefits.tsx';
import Testimonials from '../features/testimonials/Testimonials.tsx';
import Pricing from '../features/pricing/Pricing.tsx';
import FAQ from '../features/faq/FAQ.tsx';
import ContactForm from '../features/contact/ContactForm.tsx';
import Footer from '../features/navigation/Footer.tsx';
import VideoModal from '../features/testimonials/VideoModal.tsx';
import { supabase } from '../lib/supabase';

// Los planes se consultan aquí, en el build: la página es estática (no hay adaptador ni
// `output: 'server'` en astro.config.mjs). Sirven de valor inicial para que la sección de
// precios se pinte de inmediato; `Pricing` los refresca en el navegador al hidratarse, así un
// cambio desde el panel se ve al recargar sin esperar a un despliegue.
const { data: databasePlans, error } = await supabase
  .from('planes')
  .select('*')
  .eq('activo', true)
  .order('precio_mensual', { ascending: true });

if (error) {
  console.error("Error fetching plans from Supabase:", error);
}

const activePlans = databasePlans || [];
---

<Layout>
  <!-- Top Navigation bar section -->
  <Navbar client:load />

  {/* Main Page structure layout */}
  <main>
    {/* Hero Section */}
    <Hero />

    {/* Section: ¿Quiénes Somos? & Saved simulator */}
    <AboutUs client:visible />

    {/* Section: Funciones */}
    <Features />

    {/* Section: Beneficios */}
    <Benefits client:visible />

    {/* Section: Testimonios with customized play actions */}
    <Testimonials client:visible />

    {/* Section: Precios comparison */}
    <Pricing plans={activePlans} client:visible />

    {/* Section: FAQ Expandable accordion */}
    <FAQ client:visible />

    {/* Section: Contact and Request forms */}
    <ContactForm client:visible />
  </main>

  {/* Footer copyright sitemap bar */}
  <Footer />

  {/* Testimonials immersive playback modal */}
  <VideoModal client:load />
</Layout>
