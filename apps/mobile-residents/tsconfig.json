{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    // Ojo al tocar `paths`: `expo/metro-config` los aplica también como alias de Metro
    // —es lo que hace funcionar el `@/*` de aquí abajo—, así que un mapeo pensado solo
    // para TypeScript rompe el bundle. `react` se resuelve por node_modules, no por aquí.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "../../node_modules"
  ]
}