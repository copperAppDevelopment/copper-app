{
  "expo": {
    "name": "Copper App",
    "slug": "copper-residents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-copper.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.copper.residents",
      "icon": "./assets/logo-copper.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.copper.residents",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-copper.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Copper usa la cámara para escanear el código QR de tu conjunto al registrarte y para tomar fotos que envías a la administración en el chat de soporte.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Copper usa tus fotos para que elijas tu foto de perfil o adjuntes imágenes en el chat de soporte con la administración.",
          "cameraPermission": "Copper usa la cámara para escanear el código QR de tu conjunto al registrarte y para tomar fotos que envías a la administración en el chat de soporte.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-copper.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "copper-residents",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b5a7c87d-880a-457c-908d-d9365207faca"
      }
    },
    "owner": "copperappcos-team"
  }
}
