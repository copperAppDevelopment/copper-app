{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        ".astro/**"
      ],
      "env": [
        "PUBLIC_*",
        "SUPABASE_*",
        "ONESIGNAL_*",
        "RESEND_*",
        "WOMPI_*",
        "APP_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "gen:types": {
      "cache": false
    }
  }
}